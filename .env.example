# ─────────────────────────────────────────────────────────────
# The Local Rankers CRM — environment
# Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────
# Local PostgreSQL 18 running on :5432.
# Replace YOUR_PASSWORD with your postgres user's password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/localrankers_crm?schema=public"

# ── Auth.js (required) ───────────────────────────────────────
# Generate with:  npx auth secret     (or)  openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3100"
AUTH_TRUST_HOST="true"

# ── Google OAuth (optional) ──────────────────────────────────
# Leave blank to hide the "Continue with Google" button.
# console.cloud.google.com → APIs & Services → Credentials
# Redirect URI: http://localhost:3100/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email / magic link (optional) ────────────────────────────
# Leave blank to hide the magic-link form. resend.com/api-keys
AUTH_RESEND_KEY=""
EMAIL_FROM="CRM <noreply@thelocalrankers.com>"

# ── Phase 2 integrations (not used yet) ──────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
AUTHORIZENET_API_LOGIN_ID=""
AUTHORIZENET_TRANSACTION_KEY=""

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ANALYTICS_PROPERTY_ID=""
GOOGLE_SEARCH_CONSOLE_SITE=""
META_APP_ID=""
META_APP_SECRET=""

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
SLACK_WEBHOOK_URL=""

# S3 / Cloudflare R2 for file uploads
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
